{
  "extends": ["stylelint-config-standard-scss"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "custom-variant",
          "apply",
          "layer",
          "variants",
          "responsive",
          "screen",
          "tailwind",
          "utility",
          "source"
        ]
      }
    ],
    "import-notation": null,
    "no-empty-source": null
  },
  "ignoreFiles": ["dist/**/*", "node_modules/**/*"]
}
