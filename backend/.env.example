# Bright Day backend — example environment.
# Copy to `.env` and fill in real values. Never commit the `.env` file.

# Application
ENVIRONMENT=development
APP_NAME=Bright Day API
API_V1_PREFIX=/api/v1

# CORS — JSON array of allowed origins (never a wildcard in production)
CORS_ORIGINS=["http://localhost:4200"]

# Frontend base URL — used to build the email-verification redirect target.
FRONTEND_URL=http://localhost:4200

# Database — SQLAlchemy URL. Uses the psycopg (v3) driver.
# Encode special characters in the password (e.g. '#' → '%23').
DATABASE_URL="postgresql+psycopg://postgres:<YOUR_DB_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://<YOUR_PROJECT_REF>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<YOUR_SUPABASE_PUBLISHABLE_KEY>"
SUPABASE_SECRET_KEY="<YOUR_SUPABASE_SECRET_KEY>"
SUPABASE_JWT_SIGNIN_ID="<YOUR_SUPABASE_JWT_SIGNIN_ID>"
