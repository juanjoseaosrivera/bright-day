# Bright Day backend — example environment.
# Copy to `.env` and fill in real values. Never commit the `.env` file.

# Application
ENVIRONMENT=development
APP_NAME=Bright Day API
API_V1_PREFIX=/api/v1

# CORS — JSON array of allowed origins (never a wildcard in production)
CORS_ORIGINS=["http://localhost:4200"]

# Frontend base URL — used to build the email-verification redirect target.
FRONTEND_URL=http://localhost:4200

# Database — SQLAlchemy URL. Uses the psycopg (v3) driver.
# Encode special characters in the password (e.g. '#' → '%23').
DATABASE_URL="postgresql+psycopg://postgres:<YOUR_DB_PASSWORD>@db.<YOUR_PROJECT_REF>.supabase.co:5432/postgres"

# Supabase
SUPABASE_URL="https://<YOUR_PROJECT_REF>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<YOUR_SUPABASE_PUBLISHABLE_KEY>"
SUPABASE_SECRET_KEY="<YOUR_SUPABASE_SECRET_KEY>"
SUPABASE_JWT_SIGNIN_ID="<YOUR_SUPABASE_JWT_SIGNIN_ID>"

# Stripe — payment processing for subscriptions (use test-mode keys locally).
# Create products + recurring prices in the Stripe dashboard; paste the Price IDs below.
STRIPE_SECRET_KEY="sk_test_<YOUR_STRIPE_SECRET_KEY>"
STRIPE_WEBHOOK_SECRET="whsec_<YOUR_STRIPE_WEBHOOK_SECRET>"
STRIPE_PRICE_ID_WEEKLY_1="price_<WEEKLY_1_PRICE_ID>"
STRIPE_PRICE_ID_WEEKLY_3="price_<WEEKLY_3_PRICE_ID>"
STRIPE_PRICE_ID_WEEKLY_5="price_<WEEKLY_5_PRICE_ID>"

# Sessions / AI — local inference stack.
# Ollama: install + run locally, pull the model with `ollama pull llama3.1`.
# Whisper: "base" is fast and accurate enough for dev; use "small" or "medium" for prod.
# Create the "sessions-audio" bucket in Supabase Storage (non-public).
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.1"
WHISPER_MODEL_SIZE="base"
SUPABASE_STORAGE_BUCKET="sessions-audio"

# Kokoro TTS — voice output. Paths are relative to the backend/ working dir.
# Download the model files into backend/models/ (see README "Voice / TTS setup").
# If either file is missing, the server runs in text-only mode (no voice).
KOKORO_MODEL_PATH="models/kokoro-v1.0.onnx"
KOKORO_VOICES_PATH="models/voices-v1.0.bin"

# espeak-ng backend for phonemization. Leave empty to auto-detect a system
# install (Homebrew / apt). A real espeak-ng is required — the wheel bundled
# with kokoro-onnx has a broken data path. `brew install espeak-ng` on macOS.
ESPEAK_LIBRARY_PATH=""
ESPEAK_DATA_PATH=""
